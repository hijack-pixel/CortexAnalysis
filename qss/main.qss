ClickableWidget {
    border: 1px solid rgb(92, 131, 50);
    border-radius: 6px;
}

ClickableWidget:hover {
    border: 2px solid grey;
    border-radius: 6px;
    background-color:qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1,
                         stop:0 rgba(231,80,229, 200),
                         stop:1 rgba(7,208,255, 200));
}


QLabel#labelLogo {
    background-image: url(:/icon/logo.svg);
    background-position:center;
    background-repeat: no-repeat; /* 不重复 */
}


QLabel#labelLogoText {
    font-size: 12pt;

}


